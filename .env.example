# Copie para .env e ajuste. O .env não vai para o git.

# --- Banco (usado pelo docker compose e pela aplicação)
POSTGRES_USER=redenb4
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=redenb4
DB_PORTA=5434
DATABASE_URL=postgresql+asyncpg://redenb4:troque-esta-senha@127.0.0.1:5434/redenb4
# Banco usado pelos testes de integração (pytest); criado automaticamente pelo docker
TEST_DATABASE_URL=postgresql+asyncpg://redenb4:troque-esta-senha@127.0.0.1:5434/redenb4_test

# --- Portas
PORTA_AP=8765
PORTA_WEB=8000

# --- Token do AP: o mesmo valor de 'endpointToken' no perfil IoT do Aruba.
# Vazio = o servidor aceita frames de qualquer cliente na rede.
TOKEN_AP=

# --- Pesquisadores: domínio exigido no e-mail (aceita subdomínios). Vazio = qualquer domínio.
DOMINIO_EMAIL=cnpem.br

# --- Status e alertas (segundos / BPM)
OFFLINE_APOS_S=15
SEM_SINAL_ALERTA_S=30
BPM_MIN=50
BPM_MAX=150
ALERTA_DURACAO_S=10
FORA_DO_BRACO_ALERTA_S=60

# --- Retenção: leituras de BPM mais antigas que isso são apagadas (a cada hora). 0 = guarda tudo.
RETENCAO_LEITURAS_DIAS=2

# --- Login: assina o cookie de sessão (que não expira; vale até clicar em "Sair").
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Trocar este valor desloga todo mundo.
SEGREDO_SESSAO=troque-este-segredo
