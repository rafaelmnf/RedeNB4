# Copie para .env e ajuste. O .env não vai para o git.

# --- Banco (usado pelo docker compose e pela aplicação)
POSTGRES_USER=redenb4
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=redenb4
DB_PORTA=5433
DATABASE_URL=postgresql+asyncpg://redenb4:troque-esta-senha@localhost:5433/redenb4
# Banco usado pelos testes de integração (pytest); criado automaticamente pelo docker
TEST_DATABASE_URL=postgresql+asyncpg://redenb4:troque-esta-senha@localhost:5433/redenb4_test

# --- Portas
PORTA_AP=8765
PORTA_WEB=8000

# --- Status e alertas (segundos / BPM)
OFFLINE_APOS_S=15
SEM_SINAL_ALERTA_S=30
BPM_MIN=50
BPM_MAX=150
ALERTA_DURACAO_S=10

# --- Sessão de login
SESSAO_HORAS=12
# Gere um valor aleatório, ex.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SEGREDO_SESSAO=troque-este-segredo
